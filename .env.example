# OpenAI API Key (Required)
OPENAI_API_KEY=sk-your-api-key-here

# OpenAI Models (Optional - defaults provided)
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic (Optional)
ANTHROPIC_API_KEY=

# Database Credentials (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=interopera_db

# Database Connection (for local development outside Docker)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5434/${POSTGRES_DB}

# Redis (Configured in docker-compose.yml)
REDIS_URL=redis://redis:6379/0
